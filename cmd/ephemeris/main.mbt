///|
fn vector_literal(label : String, vector : @lunar_ephemeris.Vector3) -> String {
  "        \{label}: {\n" +
  "          x: \{vector.x},\n" +
  "          y: \{vector.y},\n" +
  "          z: \{vector.z},\n" +
  "        },\n"
}

///|
fn sample_literal(sample : @lunar_ephemeris.ObserverGeometrySample) -> String {
  "      {\n" +
  "        timestamp_utc: \"\{sample.timestamp_utc}\",\n" +
  "        ephemeris_time_s: \{sample.ephemeris_time_s},\n" +
  vector_literal("sun_body_fixed", sample.sun_body_fixed) +
  vector_literal("earth_body_fixed", sample.earth_body_fixed) +
  "        sun_altitude_deg: \{sample.sun_altitude_deg},\n" +
  "        sun_azimuth_deg: \{sample.sun_azimuth_deg},\n" +
  "        earth_altitude_deg: \{sample.earth_altitude_deg},\n" +
  "        earth_azimuth_deg: \{sample.earth_azimuth_deg},\n" +
  "        earth_illuminated_fraction: \{sample.earth_illuminated_fraction},\n" +
  "      },\n"
}

///|
fn moonbit_fixture(
  timeline : @lunar_ephemeris.ObserverGeometryTimeline,
) -> String {
  let mut samples = ""
  for sample in timeline.samples {
    samples += sample_literal(sample)
  }
  "///| Generated by cmd/ephemeris from the pinned DE440s kernel.\n\n" +
  "///|\n" +
  "pub fn first_trusted_square_observer_timeline_fixture() -> ObserverGeometryTimeline {\n" +
  "  {\n" +
  "    method_id: \"\{timeline.method_id}\",\n" +
  "    frame_id: \"\{timeline.frame_id}\",\n" +
  "    source_path: \"\{timeline.source_path}\",\n" +
  "    orientation_source_path: \"\{timeline.orientation_source_path}\",\n" +
  "    target_lat_deg: \{timeline.target_lat_deg},\n" +
  "    target_lon_deg: \{timeline.target_lon_deg},\n" +
  "    sample_step_minutes: \{timeline.sample_step_minutes},\n" +
  "    aggregate_step_minutes: \{timeline.aggregate_step_minutes},\n" +
  "    min_sun_altitude_deg: \{timeline.min_sun_altitude_deg},\n" +
  "    max_sun_altitude_deg: \{timeline.max_sun_altitude_deg},\n" +
  "    sunlit_hours: \{timeline.sunlit_hours},\n" +
  "    dark_hours: \{timeline.dark_hours},\n" +
  "    available_energy_wh: \{timeline.available_energy_wh},\n" +
  "    samples: [\n" +
  samples +
  "    ],\n" +
  "  }\n" +
  "}\n"
}

///|
fn updated_power_window_json(
  source : String,
  timeline : @lunar_ephemeris.ObserverGeometryTimeline,
) -> String raise {
  let evidence = @json.parse(source)
  let fields = match evidence {
    Object(value) => value
    _ => abort("power-window evidence must be a JSON object")
  }
  let computation = match fields.get("computation") {
    Some(Object(value)) => value
    _ => abort("power-window evidence must contain computation")
  }
  fields.set(
    "evidence_id",
    Json::string("first-trusted-square-power-window-computed-v2"),
  )
  computation.set("method_id", Json::string("south-pole-power-window-v2"))
  computation.set("generated_by", Json::string("MoonBit cmd/ephemeris"))
  computation.set(
    "horizon_model",
    Json::string("iau-moon-pck11-spherical-zero-horizon-v2"),
  )
  fields.set(
    "min_sun_altitude_deg",
    Json::number(timeline.min_sun_altitude_deg),
  )
  fields.set(
    "max_sun_altitude_deg",
    Json::number(timeline.max_sun_altitude_deg),
  )
  fields.set("sunlit_hours", Json::number(timeline.sunlit_hours))
  fields.set("dark_hours", Json::number(timeline.dark_hours))
  fields.set("available_energy_wh", Json::number(timeline.available_energy_wh))
  fields.set(
    "reasons",
    Json::array([
      Json::string(
        "official NAIF DE440 source files are locally pinned with byte counts and checksums",
      ),
      Json::string(
        "Sun/Moon geometry and all 13 IAU Moon orientation terms were sampled hourly over the declared UTC window",
      ),
      Json::string(
        "PCK11 spherical zero-horizon model found the Sun below the local horizon for the full window",
      ),
      Json::string(
        "local terrain-shadow and panel-attitude modeling remain conservative review blockers",
      ),
    ]),
  )
  evidence.stringify(indent=2) + "\n"
}

///|
fn main raise {
  let path = "data/sources/lunar_ephemeris/kernels/de440s.bsp"
  let json_path = "data/sources/lunar_ephemeris/first_trusted_square_observer_timeline.json"
  let power_path = "data/sources/lunar_ephemeris/first_trusted_square_power_window.json"
  let moonbit_path = "src/lunar_ephemeris/generated_first_trusted_square_observer_timeline.mbt"
  let timeline = @lunar_ephemeris.compute_first_trusted_square_observer_timeline(
    @fs.read_file_to_bytes(path),
  ).unwrap()
  let output = timeline.to_json().stringify(indent=2) + "\n"
  @fs.write_string_to_file(json_path, output)
  @fs.write_string_to_file(
    power_path,
    updated_power_window_json(@fs.read_file_to_string(power_path), timeline),
  )
  @fs.write_string_to_file(moonbit_path, moonbit_fixture(timeline))
  println("generated \{power_path}, \{json_path}, and \{moonbit_path}")
}
