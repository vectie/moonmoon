///|
fn string_array_literal(values : Array[String]) -> String {
  let mut text = ""
  for value in values {
    text += "        \"\{value}\",\n"
  }
  text
}

///|
fn decision_literal(decision : @mission.TraverseDecision) -> String {
  match @mission.traverse_decision_label(decision) {
    "allow" => "Allow"
    "review" => "Review"
    _ => "Block"
  }
}

///|
fn candidate_literal(
  candidate : @mission.RouteMissionWindowCandidate,
) -> String {
  "      {\n" +
  "        route_id: \"\{candidate.route_id}\",\n" +
  "        route_label: \"\{candidate.route_label}\",\n" +
  "        time_start_utc: \"\{candidate.time_start_utc}\",\n" +
  "        time_end_utc: \"\{candidate.time_end_utc}\",\n" +
  "        sample_offset: \{candidate.sample_offset},\n" +
  "        window_hours: \{candidate.window_hours},\n" +
  "        spherical_sunlit_hours: \{candidate.spherical_sunlit_hours},\n" +
  "        terrain_sunlit_hours: \{candidate.terrain_sunlit_hours},\n" +
  "        terrain_shadowed_hours: \{candidate.terrain_shadowed_hours},\n" +
  "        longest_dark_hours: \{candidate.longest_dark_hours},\n" +
  "        terrain_available_energy_wh: \{candidate.terrain_available_energy_wh},\n" +
  "        minimum_solar_clearance_deg: \{candidate.minimum_solar_clearance_deg},\n" +
  "        maximum_solar_clearance_deg: \{candidate.maximum_solar_clearance_deg},\n" +
  "        meets_illumination_constraint: \{candidate.meets_illumination_constraint},\n" +
  "        decision: \{decision_literal(candidate.decision)},\n" +
  "        reasons: [\n" +
  string_array_literal(candidate.reasons) +
  "        ],\n" +
  "      },\n"
}

///|
fn moonbit_fixture(evidence : @mission.MissionWindowSearchEvidence) -> String {
  let mut candidates = ""
  for candidate in evidence.candidates {
    candidates += candidate_literal(candidate)
  }
  "///| Generated by cmd/window_search from pinned DE440s and route horizons.\n\n" +
  "///|\n" +
  "fn generated_first_trusted_square_window_search_evidence() -> MissionWindowSearchEvidence {\n" +
  "  {\n" +
  "    evidence_id: \"\{evidence.evidence_id}\",\n" +
  "    site_id: \"\{evidence.site_id}\",\n" +
  "    selected_route_id: \"\{evidence.selected_route_id}\",\n" +
  "    selected_candidate_index: \{evidence.selected_candidate_index},\n" +
  "    source_path: \"\{evidence.source_path}\",\n" +
  "    orientation_source_path: \"\{evidence.orientation_source_path}\",\n" +
  "    search_start_utc: \"\{evidence.search_start_utc}\",\n" +
  "    search_end_utc: \"\{evidence.search_end_utc}\",\n" +
  "    window_hours: \{evidence.window_hours},\n" +
  "    stride_hours: \{evidence.stride_hours},\n" +
  "    windows_per_route: \{evidence.windows_per_route},\n" +
  "    generated_by: \"\{evidence.generated_by}\",\n" +
  "    candidates: [\n" +
  candidates +
  "    ],\n" +
  "  }\n" +
  "}\n"
}

///|
fn main raise {
  let kernel_path = "data/sources/lunar_ephemeris/kernels/de440s.bsp"
  let orientation_path = "data/sources/lunar_ephemeris/kernels/pck00011.tpc"
  let output_path = "data/sources/lunar_ephemeris/first_trusted_square_window_search.json"
  let fixture_path = "src/mission/generated_first_trusted_square_window_search.mbt"
  let search_start_unix_s = 1783555200L
  let solar_track = @lunar_ephemeris.compute_solar_geometry_track(
    @fs.read_file_to_bytes(kernel_path),
    search_start_unix_s,
    365 * 24,
    -89.88,
    0.12,
  ).unwrap()
  let evidence = @mission.rank_route_mission_windows(
    "first-trusted-square",
    "northeast-stepout",
    @mission.first_trusted_square_route_candidates(),
    solar_track,
    search_start_unix_s,
    14 * 24,
    24,
    kernel_path,
    orientation_path,
    @mission.conservative_illumination_constraint(),
  ).unwrap()
  @fs.write_string_to_file(
    output_path,
    evidence.to_json().stringify(indent=2) + "\n",
  )
  @fs.write_string_to_file(fixture_path, moonbit_fixture(evidence))
  println("generated \{output_path} and \{fixture_path}")
}
