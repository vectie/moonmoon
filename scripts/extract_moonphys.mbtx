///|
import {
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/x/fs",
  "moonbitlang/x/crypto",
}

///|
fn files(folder : String, prefix : String) -> Array[String] raise {
  let result : Array[String] = []
  let entries = @fs.read_dir(folder + "/" + prefix).to_owned()
  entries.sort()
  for name in entries {
    let relative = if prefix == "" { name } else { prefix + "/" + name }
    if @fs.is_dir(folder + "/" + relative) {
      result.append(files(folder, relative))
    } else {
      result.push(relative)
    }
  }
  result
}

///|
fn exports(interface : String) -> Array[String] {
  let names : Array[String] = []
  for line in interface.split("\n") {
    let text = line.to_owned()
    if text.has_prefix("pub fn ") {
      let name = text[7:].split("(").to_array()[0].to_owned()
      if !name.contains("::") {
        names.push(name)
      }
    } else {
      for
        prefix in [
          "pub(all) struct ", "pub(all) enum ", "pub struct ", "pub enum ", "pub type ",
          "pub(all) suberror ", "pub suberror ",
        ] {
        if text.has_prefix(prefix) {
          let name = text[prefix.length():].split(" ").to_array()[0].to_owned()
          names.push("type " + name)
        }
      }
    }
  }
  names
}

///|
fn facade(package_alias : String, names : Array[String]) -> String {
  "// Generated by scripts/extract_moonphys.mbtx from the archived original interface.\n" +
  "// Canonical implementations and methods belong to vectie/moonphys or moonnum/geometry.\n" +
  "///|\npub using @" +
  package_alias +
  " {\n  " +
  names.join(",\n  ") +
  ",\n}\n"
}

///|
fn write_facades(source : String, archive : String) -> Unit raise {
  let main = exports(
    @fs.read_file_to_string(archive + "/pkg.generated.mbti.source"),
  )
  let review = exports(
    @fs.read_file_to_string(archive + "/review/pkg.generated.mbti.source"),
  )
  @fs.write_string_to_file(
    source + "/compatibility.mbt",
    facade("physics", main),
  )
  @fs.write_string_to_file(
    source + "/moon.pkg",
    "import {\n  \"vectie/moonphys\" @physics,\n}\n\nimport {\n  \"vectie/moonphys\" @canonical,\n  \"vectie/moonnum/geometry\",\n  \"moonbitlang/core/json\",\n} for \"test\"\n",
  )
  @fs.write_string_to_file(
    source + "/review/compatibility.mbt",
    facade("physical_review", review),
  )
  @fs.write_string_to_file(
    source + "/review/moon.pkg",
    "import {\n  \"vectie/moonphys/review\" @physical_review,\n}\n\nimport {\n  \"vectie/moonphys/review\" @canonical_review,\n} for \"test\"\n",
  )
  println(
    "Forwarded " +
    main.length().to_string() +
    " root declarations and " +
    review.length().to_string() +
    " review declarations; methods resolve through their canonical public owners.",
  )
}

///|
struct ArchivedFile {
  original : String
  snapshot : String
  sha256 : String
  bytes : Int32
} derive(FromJson)

///|
struct ArchiveManifest {
  files : Array[ArchivedFile]
} derive(FromJson)

///|
fn signatures(source : String) -> Array[String] {
  source
  .split("\n")
  .filter_map(line => {
    if line.has_prefix("pub fn ") {
      Some(
        line
        .to_owned()
        .replace_all(old="@geometry.", new="")
        .replace_all(old="Int32", new="Int"),
      )
    } else {
      None
    }
  })
  .to_array()
}

///|
fn normalized_source(source : String) -> String {
  let chars = source.iter().to_array()
  let tokens : Array[String] = []
  let mut i = 0
  while i < chars.length() {
    let c = chars[i]
    if c.is_whitespace() {
      i += 1
    } else if c == '/' && chars.get(i + 1) == Some('/') {
      while i < chars.length() && chars[i] != '\n' {
        i += 1
      }
    } else if c == '"' || c == '\'' {
      let quote = c
      let mut literal = c.to_string()
      i += 1
      while i < chars.length() {
        let next = chars[i]
        literal += next.to_string()
        i += 1
        if next == '\\' && i < chars.length() {
          literal += chars[i].to_string()
          i += 1
        } else if next == quote {
          break
        }
      }
      // Preserve literal contents exactly, including whitespace and Int32 text.
      tokens.push(literal)
    } else if c.is_ascii_alphabetic() || c == '_' {
      let mut word = c.to_string()
      i += 1
      while i < chars.length() &&
            (
              chars[i].is_ascii_alphabetic() ||
              chars[i].is_ascii_digit() ||
              chars[i] == '_'
            ) {
        word += chars[i].to_string()
        i += 1
      }
      tokens.push(if word == "Int32" { "Int" } else { word })
    } else {
      tokens.push(c.to_string())
      i += 1
    }
  }
  let normalized : Array[String] = []
  for index, token in tokens {
    if token == "," &&
      tokens.get(index + 1) is Some(next) &&
      [")", "}", "]"].contains(next) {
      continue
    }
    if token == "?" && tokens.get(index + 1) == Some(":") {
      let mut cursor = index + 2
      let mut has_default = false
      while cursor < tokens.length() &&
            tokens[cursor] != "," &&
            tokens[cursor] != ")" {
        if tokens[cursor] == "=" {
          has_default = true
          break
        }
        cursor += 1
      }
      normalized.push(if has_default { "~" } else { token })
    } else {
      normalized.push(token)
    }
  }
  normalized.join(" ")
}

///|
fn verify_archive(destination : String, archive : String) -> Unit raise {
  let manifest : ArchiveManifest = @json.from_json(
    @json.parse(@fs.read_file_to_string(archive + "/manifest.json")),
  )
  let mut relocated_sources = 0
  let mut test_cases = 0
  for item in manifest.files {
    let bytes = @fs.read_file_to_bytes(archive + "/" + item.snapshot)
    if bytes.length() != item.bytes ||
      @crypto.bytes_to_hex_string(@crypto.sha256(bytes)) != item.sha256 {
      fail("archive integrity failure: " + item.original)
    }
    let relative = item.original["src/moonphys/".length():].to_owned()
    if relative.has_suffix(".mbt") {
      let original = @fs.read_file_to_string(archive + "/" + item.snapshot)
      let expected = if relative == "transform.mbt" {
        original.replace(
          old="fn normalized_axis(",
          new="pub fn normalized_axis(",
        )
      } else {
        original
      }
      let target = if relative == "vector.mbt" || relative == "transform.mbt" {
        destination + "/../moonnum/geometry/" + relative
      } else {
        destination + "/" + relative
      }
      // Formatter edits: Int -> Int32, record commas, and defaulted label spelling.
      if normalized_source(@fs.read_file_to_string(target)) !=
        normalized_source(expected) {
        fail(
          "relocated implementation differs beyond ownership-only edits: " +
          target,
        )
      }
      relocated_sources += 1
      if relative.has_suffix("_test.mbt") {
        test_cases += original
          .split("\n")
          .filter(line => line.has_prefix("test "))
          .count()
      }
    }
  }
  let original = @fs.read_file_to_string(archive + "/pkg.generated.mbti.source")
  let canonical = @fs.read_file_to_string(destination + "/pkg.generated.mbti") +
    "\n" +
    @fs.read_file_to_string(
      destination + "/../moonnum/geometry/pkg.generated.mbti",
    )
  let canonical_signatures = signatures(canonical)
  let original_signatures = signatures(original)
  for signature in original_signatures {
    if !canonical_signatures.contains(signature) {
      fail(
        "missing or changed original function/method signature: " + signature,
      )
    }
  }
  let old_review = signatures(
    @fs.read_file_to_string(archive + "/review/pkg.generated.mbti.source"),
  )
  let new_review = signatures(
    @fs.read_file_to_string(destination + "/review/pkg.generated.mbti"),
  )
  if old_review != new_review {
    fail("review function signatures changed")
  }
  println(
    "Verified " +
    manifest.files.length().to_string() +
    " archive SHA-256 entries, " +
    relocated_sources.to_string() +
    " relocated source files (formatter-only token normalization), " +
    test_cases.to_string() +
    " preserved test cases, and " +
    (original_signatures.length() + old_review.length()).to_string() +
    " unchanged public function/method signatures. No physics or test was executed.",
  )
}

///|
fn main raise {
  let args = @env.args()
  guard args.length() == 4 else {
    fail(
      "usage: moon run --target native scripts/extract_moonphys.mbtx -- extract|refresh-facades|verify /ABSOLUTE/moonmoon /ABSOLUTE/moonphys",
    )
  }
  let mode = args[1]
  let moonmoon = args[2]
  let destination = args[3]
  let source = moonmoon + "/src/moonphys"
  let archive = destination + "/docs/provenance/moonmoon-moonphys-20261023"
  if mode == "verify" {
    verify_archive(destination, archive)
    return
  }
  if mode == "refresh-facades" {
    write_facades(source, archive)
    return
  }
  guard mode == "extract" else { fail("unknown mode") }
  guard !@fs.path_exists(archive + "/manifest.json") else {
    fail(
      "Extraction already archived; use refresh-facades without recopying or deleting canonical source.",
    )
  }
  let original_files = files(source, "")
  let manifest : Array[Json] = []
  // Finish every original-byte snapshot before removing any old implementation.
  for relative in original_files {
    let bytes = @fs.read_file_to_bytes(source + "/" + relative)
    @fs.write_bytes_to_file(archive + "/" + relative + ".source", bytes)
    let geometry = relative == "vector.mbt" || relative == "transform.mbt"
    let relocated = if geometry {
      "vectie/moonnum/geometry/" + relative
    } else {
      "vectie/moonphys/" + relative
    }
    manifest.push({
      "original": "src/moonphys/" + relative,
      "snapshot": relative + ".source",
      "sha256": @crypto.bytes_to_hex_string(@crypto.sha256(bytes)),
      "bytes": bytes.length(),
      "relocated": relocated,
    })
    if !geometry &&
      relative != "moon.pkg" &&
      relative != "pkg.generated.mbti" &&
      relative != "review/pkg.generated.mbti" {
      @fs.write_bytes_to_file(destination + "/" + relative, bytes)
    }
  }
  let record : Json = {
    "schema": "moonphys-source-extraction-v1",
    "source_module": "vectie/moonmoon@0.1.0",
    "source_head": "38a9791b260516e67814d9e4c2aba52875880d02",
    "source_path_last_commit": "ba21f3985baeeb02a97bb03f0ad2f086ee27ef24",
    "captured_on": "2026-10-23",
    "preexisting_dirty_path_preserved": "ui/rabbita-moon/moon.mod",
    "files": manifest,
  }
  @fs.write_string_to_file(
    archive + "/manifest.json",
    record.stringify(indent=2) + "\n",
  )
  let geometry_names = exports(
    @fs.read_file_to_string(archive + "/pkg.generated.mbti.source"),
  )
  let geometry_exports = geometry_names.filter(name => {
    [
      "type Vec3", "type Basis3", "type Transform3", "vec3", "identity_basis3", "yaw_basis3",
      "axis_angle_basis3", "transform3",
    ].contains(name)
  })
  @fs.write_string_to_file(
    destination + "/geometry.mbt",
    facade("geometry", geometry_exports) +
    "\n///|\nfn normalized_axis(axis : Vec3) -> Vec3 {\n  @geometry.normalized_axis(axis)\n}\n",
  )
  for relative in original_files {
    if relative.has_suffix(".mbt") {
      @fs.remove_file(source + "/" + relative)
    }
  }
  write_facades(source, archive)
  println(
    "Archived and relocated " +
    original_files.length().to_string() +
    " original files. No test, simulation, training, or hardware code was executed.",
  )
}
